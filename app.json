{
   "expo": {
      "name": "Movapp",
      "slug": "movapp-app",
      "version": "1.0.1",
      "orientation": "portrait",
      "icon": "./assets/icons/icon.png",
      "scheme": "movapp",
      "userInterfaceStyle": "automatic",

      "ios": {
         "supportsTablet": true,
         "bundleIdentifier": "com.movapp.mobile",
         "infoPlist": {
            "ITSAppUsesNonExemptEncryption": false
         }
      },

      "android": {
         "adaptiveIcon": {
            "foregroundImage": "./assets/icons/icon.png",
            "backgroundColor": "#050505"
         },
         "edgeToEdgeEnabled": true,
         "package": "com.movapp.mobile",
         "minSdkVersion": 21
      },

      "web": {
         "bundler": "metro",
         "output": "static",
         "favicon": "./assets/icons/movapp.png"
      },

      "plugins": [
         "expo-router",
         [
            "expo-splash-screen",
            {
               "image": "./assets/images/elhack.png",
               "imageWidth": 200,
               "resizeMode": "contain",
               "backgroundColor": "#050505"
            }
         ],
         [
            "expo-build-properties",
            {
               "android": {
                  "newArchEnabled": true
               },
               "ios": {
                  "newArchEnabled": true
               }
            }
         ],
         [
            "@stripe/stripe-react-native",
            {
               "merchantIdentifier": "merchant.com.movapp.mobile",
               "enableGooglePay": true
            }
         ],
         "expo-font",
         "expo-secure-store",
         "expo-web-browser"
      ],

      "experiments": {
         "typedRoutes": true
      },

      "extra": {
         "router": {},
         "eas": {
            "projectId": "197eaaeb-4090-4e85-b082-35f3420991da"
         }
      },

      "runtimeVersion": {
         "policy": "appVersion"
      },

      "updates": {
         "enabled": true,
         "url": "https://u.expo.dev/197eaaeb-4090-4e85-b082-35f3420991da",
         "fallbackToCacheTimeout": 0,
         "checkAutomatically": "ON_LOAD"
      }
   }
}
