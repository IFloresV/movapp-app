{
   "expo": {
      "name": "Movapp",
      "slug": "movapp-app",
      "version": "1.0.4",
      "orientation": "portrait",
      "icon": "./assets/icons/icon.png",
      "scheme": "movapp",
      "userInterfaceStyle": "automatic",

      "ios": {
         "supportsTablet": true,
         "bundleIdentifier": "com.movapp.mobile",
         "buildNumber": "21",
         "infoPlist": {
            "UIBackgroundModes": ["remote-notification"],
            "ITSAppUsesNonExemptEncryption": false,
            "NSCameraUsageDescription": "Movapp necesita acceso a la cámara para permitir cargar imágenes y completar funcionalidades dentro de la plataforma.",
            "NSPhotoLibraryUsageDescription": "Movapp necesita acceso a tus fotos para permitir cargar imágenes dentro de la plataforma.",
            "NSPhotoLibraryAddUsageDescription": "Movapp necesita guardar imágenes en tu galería cuando el usuario lo solicita.",
            "NSUserNotificationsUsageDescription": "Movapp utiliza notificaciones para enviarte avisos importantes sobre tu cuenta, servicios, pagos y actualizaciones relevantes."
         }
      },

      "android": {
         "adaptiveIcon": {
            "foregroundImage": "./assets/icons/icon.png",
            "backgroundColor": "#050505"
         },
         "edgeToEdgeEnabled": true,
         "package": "com.movapp.mobile",
         "versionCode": 23,
         "minSdkVersion": 21,
         "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "NOTIFICATIONS"],
         "googleServicesFile": "./google-services.json",
         "useNextNotificationsApi": true
      },

      "web": {
         "bundler": "metro",
         "output": "static",
         "favicon": "./assets/icons/movapp.png"
      },

      "plugins": [
         "expo-router",
         [
            "expo-splash-screen",
            {
               "image": "./assets/images/elhack.png",
               "imageWidth": 200,
               "resizeMode": "contain",
               "backgroundColor": "#050505"
            }
         ],
         [
            "expo-build-properties",
            {
               "android": {
                  "newArchEnabled": true
               },
               "ios": {
                  "newArchEnabled": true
               }
            }
         ],
         [
            "@stripe/stripe-react-native",
            {
               "merchantIdentifier": "merchant.com.movapp.mobile",
               "enableGooglePay": true
            }
         ],
         ["expo-notifications"],
         "expo-font",
         "expo-secure-store",
         "expo-web-browser"
      ],

      "experiments": {
         "typedRoutes": true
      },

      "extra": {
         "router": {},
         "eas": {
            "projectId": "197eaaeb-4090-4e85-b082-35f3420991da"
         }
      },

      "runtimeVersion": {
         "policy": "appVersion"
      },

      "updates": {
         "enabled": true,
         "url": "https://u.expo.dev/197eaaeb-4090-4e85-b082-35f3420991da",
         "fallbackToCacheTimeout": 0,
         "checkAutomatically": "ON_LOAD"
      },

      "notification": {
         "icon": "./assets/icons/notification-icon.png",
         "color": "#ffffff"
      }
   }
}
